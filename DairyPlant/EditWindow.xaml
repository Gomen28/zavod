<Window x:Class="DairyPlant.EditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DairyPlant"
        mc:Ignorable="d"
        Title="Редактирование пользователя" MinWidth="350" MinHeight="200"
        Height="350" Width="450">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="5*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>
        <Grid Grid.Column="1" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock  Text="Имя:" FontSize="16" Margin="0,0,0,10"  VerticalAlignment="Center"/>
                <TextBlock  Text="Логин:" FontSize="16" Margin="0,0,0,10" VerticalAlignment="Center"/>
                <TextBlock Text="Пароль:" FontSize="16" Margin="0,0,0,10" VerticalAlignment="Center"/>
                <TextBlock Text="Роль:" FontSize="16" Margin="0,0,0,10" VerticalAlignment="Center"/>
                <TextBlock Text="Заблокирован:" FontSize="16" Margin="0,0,0,20" VerticalAlignment="Center"/>
                <Button x:Name="BtnSave" Content="Сохранить" Width="150" Height="25" FontSize="16" Click="BtnSave_Click"/>
                
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBox x:Name="NameBox" FontSize="16" Margin="0,0,0,10" VerticalAlignment="Center"/>
                <TextBox x:Name="LoginBox" FontSize="16" Margin="0,0,0,10" VerticalAlignment="Center"/>
                <PasswordBox x:Name="PasswordBox" Margin="0,0,0,10" FontSize="16" VerticalAlignment="Center"/>
                <ComboBox x:Name="RoleBox" Margin="0,0,0,10">
                    <ComboBoxItem Content="admin" />
                    <ComboBoxItem Content="user" />
                </ComboBox>
                <CheckBox x:Name="BlockBox" FontSize="16" Margin="0,0,0,20" VerticalAlignment="Center"/>
                <Button x:Name="BtnCancel" Content="Отмена" Width="150" Height="25" FontSize="16" Click="BtnCancel_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
